# Facebook / WhatsApp Cloud API
ACCESS_TOKEN=your_whatsapp_access_token_here
APP_SECRET=your_facebook_app_secret_here
APP_ID=your_facebook_app_id_here

# Webhook URL verification (GET /webhook)
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
# VERIFY_TOKEN=legacy_same_value_ok  # legado — prefer WHATSAPP_VERIFY_TOKEN

# Ativos da Meta — IDs de conta e o PIN do número.
# O runtime NÃO lê estas variáveis: o bot pega o phone_number_id do payload do
# webhook (app.js:112). Elas existem para scripts/meta-numero.sh e para não
# deixar identificador nem PIN em arquivo versionado (repositório público).
# Onde encontrar cada valor: docs/meta/referencia.md
BUSINESS_ID=your_meta_business_id_here
WABA_ID=your_whatsapp_business_account_id_here
PHONE_NUMBER_ID=your_phone_number_id_here
# PIN da verificação em duas etapas, definido ao cadastrar o número.
# É SEGREDO: protege o re-registro do número em outra instância da Cloud API.
# Não pode ser desativado por API e é exigido para excluir um número conectado.
WHATSAPP_2FA_PIN=your_six_digit_pin_here
# Legado — número anterior travado em ON_PREMISE, mantido só para consulta.
# Ver docs/meta/historico-migracao-smb.md
# WABA_ID_LEGADO=
# PHONE_NUMBER_ID_LEGADO=
# PIN do número legado. Se ainda for o default público da Meta (000000), ele
# não protege nada — troque antes de qualquer tentativa de reativar o número.
# WHATSAPP_2FA_PIN_LEGADO=

# Server
PORT=8080

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Janela (segundos) em que a lista de boletos continua clicável para
# re-selecionar sem redigitar o CPF (sliding TTL). Default: 1800 (30 min)
ESTADO_TTL_SECONDS=1800

# Notificação de atendente por e-mail (clique em "Falar com atendente")
# Sem estas variáveis a notificação é ignorada (no-op) — o bot segue funcionando.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bot Assusa <bot@assusa.com.br>"
ATENDENTE_EMAIL_TO=

# Microsserviço Python (boletos Sicoob)
SICOOB_SERVICE_URL=http://127.0.0.1:8090
INTERNAL_API_KEY=your_internal_api_key_here
# true = sandbox (sem certificados reais); false = produção
SICOOB_SANDBOX=true
# Quantidade de janelas de 30 dias paralelas (1 janela = 1 mês de histórico)
# Default: 6 (cobre 6 meses, suficiente para inadimplência típica até o corte)
SICOOB_NUM_JANELAS=6

# Credenciais Sicoob — obrigatórias quando SICOOB_SANDBOX=false
SICOOB_CLIENT_ID=your_sicoob_client_id_here
# Número de cliente da Assusa no Sicoob (cedente)
SICOOB_NUMERO_CLIENTE=

# Certificados mTLS (arquivos extraídos do .pfx — obrigatórios em produção)
# Em Docker os caminhos são definidos no docker-compose.yml (/certs/...)
# Preencha abaixo apenas ao rodar o serviço Python fora do Docker
# SICOOB_CERT_PATH=/path/to/certificados/certificado.pem
# SICOOB_KEY_PATH=/path/to/certificados/private_key.pem
# Senha do .p12/.pfx original — necessária para extrair cert/chave.
# SEGREDO: nunca versionar. A pasta certificados/ já está no .gitignore.
SICOOB_P12_PASSWORD=your_p12_password_here

# URLs Sicoob — valores abaixo são os defaults do código; só defina para sobrescrever
# SICOOB_PROD_BASE_URL=https://api.sicoob.com.br
# SICOOB_SANDBOX_BASE_URL=https://sandbox.sicoob.com.br/sicoob/sandbox
# SICOOB_SANDBOX_TOKEN=
# SICOOB_SANDBOX_CLIENT_ID=

# PostgreSQL (persistência de interações)
DATABASE_URL=postgresql://assusa:change_me@localhost:5432/assusa
POSTGRES_PASSWORD=change_me